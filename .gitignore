# Maven
target/
*.versionsBackup
dependency-reduced-pom.xml

# IDE
.idea/
*.iml
.vscode/
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db

# Local build outputs
_prefix/
_legacy-prefix/
out/

# Native artifacts staged in resources are produced by CI; keep the directories
# (with .gitkeep) but ignore the built libraries themselves. Legerix owns
# META-INF/legerix/ and nothing else in the jar (Legerix#21).
src/main/resources/META-INF/legerix/natives/*/*.so*
src/main/resources/META-INF/legerix/natives/*/*.dylib
src/main/resources/META-INF/legerix/natives/*/*.dll
src/main/resources/META-INF/legerix/tessdata/*.traineddata

# Per-tier natives manifest, written by scripts/write-natives-manifest.sh at build time.
src/main/resources/META-INF/legerix/natives/*/legerix-natives.txt
